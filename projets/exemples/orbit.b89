' Orbits - Basic89 example of FIXED numbers and grayscale
' A planet turns around the sun, a moon around the planet.
' UP / DOWN: faster / slower    ESC: quit

DIM angle AS FIXED, speed AS FIXED = 0.03
DIM px AS FIXED, py AS FIXED, mx AS FIXED, my AS FIXED

SCREEN GRAY4 BUFFERED
DO
  IF KEYDOWN(KEY_UP) THEN speed = MIN(speed + 0.002, 0.2)
  IF KEYDOWN(KEY_DOWN) THEN speed = MAX(speed - 0.002, 0)
  angle += speed
  IF angle > 2 * PI THEN angle -= 2 * PI

  px = 80 + 30 * COS(angle)               ' planet: radius 30
  py = 52 + 30 * SIN(angle)
  mx = px + 10 * COS(angle * 5)           ' moon: 5 turns per year
  my = py + 10 * SIN(angle * 5)

  CLS
  CIRCLE 80, 52, 30, LIGHTGRAY            ' the orbit
  CIRCLE 80, 52, 8, DARKGRAY FILL         ' the sun
  CIRCLE 80, 52, 8, BLACK
  CIRCLE px, py, 4, BLACK FILL            ' the planet
  CIRCLE mx, my, 1, DARKGRAY FILL         ' the moon
  LOCATE 1, 1
  PRINT "speed "; speed
  FLIP
  WAITFRAME 32
LOOP UNTIL KEYDOWN(KEY_ESC)
